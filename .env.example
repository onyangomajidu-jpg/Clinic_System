# Copy this file to .env and adjust values for your local setup.
# .env is git-ignored and should never be committed.

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Initial admin login (auto-provisioned by `python manage.py create_admin`)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-this-admin-password

# Database
# Set DB_ENGINE=sqlite3 for local development without Docker (default),
# or DB_ENGINE=postgresql when running via docker-compose.
DB_ENGINE=sqlite3
DB_NAME=clinic_system
DB_USER=clinic_user
DB_PASSWORD=clinic_password
DB_HOST=db
DB_PORT=5432
